# ============================================================
# SERVIDOR
# ============================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# ============================================================
# BASE DE DATOS
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pms_motel_db?schema=public"

# ============================================================
# JWT
# ============================================================
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_seguro_minimo_64_chars
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh_tokens_minimo_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# WHATSAPP OTP (Twilio / Meta WhatsApp Business API)
# ============================================================
WHATSAPP_PROVIDER=twilio        # twilio | meta
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# -- O si usas Meta directamente --
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# ============================================================
# OTP
# ============================================================
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# ============================================================
# PAGOS
# ============================================================
# Pago Móvil (registro manual + webhook interno)
PAGO_MOVIL_WEBHOOK_SECRET=secreto_webhook_pago_movil

# Binance Pay (opcional, fase posterior)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_MERCHANT_ID=

# Zelle (verificación manual con confirmación del propietario)
ZELLE_CONFIRMATION_TIMEOUT_MIN=30

# ============================================================
# AWS S3 (fotos de habitaciones)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=pms-motel-assets

# ============================================================
# BCRYPT
# ============================================================
BCRYPT_ROUNDS=12

# ============================================================
# QR
# ============================================================
QR_SECRET_KEY=secreto_para_firmar_tokens_qr_minimo_32_chars
